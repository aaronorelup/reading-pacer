# Reading Pacer — configuration
#
# Copy this file to `.env` (next to the repo, or in your user data dir —
# %APPDATA%\ReadingPacer on Windows, ~/Library/Application Support/ReadingPacer
# on macOS, ~/.local/share/reading-pacer on Linux) and fill in your values.
# Everything here can also be edited from the in-app Settings screen.
#
# The pacer itself works with NO configuration — an LLM is only needed for
# comprehension quizzes and passage generation.

# ── API model (DeepSeek by default; any OpenAI-compatible endpoint works) ──
# Get a DeepSeek key at https://platform.deepseek.com
LLM_API_KEY=
LLM_API_MODEL=deepseek-chat
LLM_API_BASE_URL=https://api.deepseek.com/v1/chat/completions

# ── Local model (optional fallback; requires `pip install reading-pacer[local]`) ──
LLM_LOCAL_PATH=
LLM_LOCAL_CONTEXT_SIZE=4096
LLM_LOCAL_GPU_LAYERS=35

# ── Preferences ──
# Which provider to try first: "api" or "local" (the other is the fallback)
LLM_DEFAULT_PROVIDER=api
# Theme: "mocha" (dark) or "latte" (light)
THEME=mocha
# Questions per comprehension quiz (3-12)
QUIZ_QUESTIONS=8
# Check GitHub for a new version at startup (true/false)
CHECK_FOR_UPDATES=true
